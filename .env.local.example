# ════════════════════════════════════════════════════════════════════════
# 신혼생활 (sinhon.life) 환경변수
# ════════════════════════════════════════════════════════════════════════
# 사용법: 이 파일을 .env.local로 복사한 뒤 각 값을 채워 넣으세요
#   cp .env.local.example .env.local
#
# Vercel 배포 시에는 Vercel 대시보드 → Project → Settings → Environment Variables 에 등록
# ────────────────────────────────────────────────────────────────────────

# Supabase — https://supabase.com 에서 무료 프로젝트 생성 후 Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 카카오 로그인은 Supabase 대시보드에서 Provider로 등록 (별도 env 불필요)
#   Authentication → Providers → Kakao 활성화 → Client ID/Secret 입력
#   Kakao Developers (https://developers.kakao.com)에서 앱 생성 후
#   Redirect URI를 [Supabase URL]/auth/v1/callback 으로 등록

# 사이트 URL (OAuth 리다이렉트, 메일 등에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
