# Shared
NODE_ENV=development

# API
PORT=4000
AUTH_TOKEN_SECRET=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=604800
PII_ENCRYPTION_KEY=local-dev-pii-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
ADMIN_ALLOWED_ORIGINS=http://localhost:3001

# Local PostgreSQL is provided by docker-compose.yml on host port 5433.
DATABASE_URL=postgresql://sinhon_os:sinhon_os@localhost:5433/sinhon_os?schema=public
DIRECT_URL=postgresql://sinhon_os:sinhon_os@localhost:5433/sinhon_os?schema=public

# Web apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# 신혼생활 웹앱 (apps/web · POLIS) — 실제 API 키
# 아래 값이 없어도 앱은 시드/시뮬레이션으로 동작하지만,
# 채워 넣으면 화면이 실제 데이터로 살아납니다.
# ─────────────────────────────────────────────────────────────

# 보조금24 OpenAPI — 정책 목록 실시간 조회 (/api/policies)
# 발급: https://www.data.go.kr 에서 "보조금24 서비스목록" 활용신청 → 일반 인증키(Decoding)
GOV24_SERVICE_KEY=

# Anthropic API — 두리AI 정책 챗봇 (/api/policy-chat, claude-haiku-4-5)
# 발급: https://console.anthropic.com  (미설정 시 규칙 기반 폴백 응답)
ANTHROPIC_API_KEY=

# Upstash Redis (Vercel KV 호환) — 실시간 트렌드 집계 (/api/track, /api/trends)
# 발급: Vercel 프로젝트 → Storage → KV, 또는 https://upstash.com
# 미설정 시 트렌드는 결정론적 시뮬레이션으로 표시됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 카카오 로그인 — 회원 가입/로그인 (Kakao JS SDK)
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
#   1) 플랫폼 > Web 에 서비스 도메인 등록 (예: https://sinhon.life)
#   2) 카카오 로그인 활성화 + 동의항목(닉네임·프로필사진)
# 미설정 시 로그인 화면의 "둘러보기(게스트)"로 앱 전체를 이용할 수 있습니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
