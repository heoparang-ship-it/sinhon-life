# ========================================
# 신혼생활 MVP 환경변수 설정
# ========================================
# 이 파일을 .env.local로 복사한 후 실제 값을 입력하세요
# cp .env.example .env.local
# ========================================

# Anthropic API Key (서버 전용 — Haiku 호출용)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Pinecone API Key (벡터 검색용)
PINECONE_API_KEY=pcsk_xxxxx

# App URL (Amplify 배포 후 업데이트)
NEXT_PUBLIC_APP_URL=https://sinhon.life

# ========================================
# /admin 인증 비밀번호 — 16자 이상 랜덤 문자열 권장
# 미설정 시 모든 /admin 접근이 로그인 페이지로 리다이렉트됨
# ========================================
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ========================================
# Sentry (선택) — 프론트/서버 에러 추적
# ========================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ========================================
# 인스타 미러링 워커 (worker/README.md 참고)
# 배포된 Cloudflare Worker URL — 슬래시 없이 끝.
# 미설정 시 /archive 라우트는 빈 상태로 동작 (에러 메시지 노출).
# ========================================
NEXT_PUBLIC_INSTAGRAM_API_URL=https://sinhon-life-api.YOUR-SUBDOMAIN.workers.dev

# ========================================
# 보조금24 통합검색 API (행정안전부, data.go.kr 데이터셋 15113968)
# ----------------------------------------
# 발급: data.go.kr 가입 → 데이터셋 15113968 → "활용신청" (자동승인, 1일 내)
# 발급된 일반 인증키(Encoding 키) 그대로 붙여넣기. URL 디코딩 X.
# 미설정 시 큐레이트 11종(/lib/policy/data)만 사용 — AI가 보조금24 후보 추가 안 함.
# 일 10,000건 한도. /api/policy/search 와 /api/chat 의 정책 의도 응답에서 사용.
# ========================================
GOV24_API_KEY=

# ========================================
# 온통청년 OpenAPI v3 (youthcenter.go.kr)
# ----------------------------------------
# 발급: youthcenter.go.kr 회원가입 → 마이페이지 > OPEN API 신청 (즉시 발급)
# 청년(만 19~39세) 정책 통합검색. 신혼 청년이 받을 수 있는 청년 한정 정책
# (청년월세지원·임차보증금 이자지원 등)을 보조금24가 놓치는 경우 보완.
# 미설정 시 보조금24/큐레이트만 사용.
# ========================================
YOUTH_API_KEY=
