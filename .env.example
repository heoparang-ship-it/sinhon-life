# Shared
NODE_ENV=development

# API
PORT=4000
AUTH_TOKEN_SECRET=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=604800
PII_ENCRYPTION_KEY=local-dev-pii-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
ADMIN_ALLOWED_ORIGINS=http://localhost:3001

# Local PostgreSQL is provided by docker-compose.yml on host port 5433.
DATABASE_URL=postgresql://sinhon_os:sinhon_os@localhost:5433/sinhon_os?schema=public
DIRECT_URL=postgresql://sinhon_os:sinhon_os@localhost:5433/sinhon_os?schema=public

# Web apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
