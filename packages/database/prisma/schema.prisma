model LeadRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  coupleId               String    @map("couple_id") @db.Uuid
  compareRoomId          String    @map("compare_room_id") @db.Uuid
  compareCardId          String?   @map("compare_card_id") @db.Uuid
  offerId                String?   @map("offer_id") @db.Uuid
  vendorId               String    @map("vendor_id") @db.Uuid
  offerPriceVersionId    String?   @map("offer_price_version_id") @db.Uuid
  status                 String
  preferredContactMethod String    @map("preferred_contact_method")
  preferredContactDates  Json?     @map("preferred_contact_dates") @db.JsonB
  contactNameEncrypted   String?   @map("contact_name_encrypted")
  contactPhoneEncrypted  String?   @map("contact_phone_encrypted")
  contactPhoneHash       String?   @map("contact_phone_hash")
  messageEncrypted       String?   @map("message_encrypted")
  consentGivenAt         DateTime  @map("consent_given_at") @db.Timestamptz(6)
  submittedByUserId      String    @map("submitted_by_user_id") @db.Uuid
  submittedAt            DateTime  @map("submitted_at") @db.Timestamptz(6)
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  couple            Couple              @relation("LeadRequestCouple", fields: [coupleId], references: [id], onDelete: Restrict)
  compareRoom       CompareRoom         @relation("LeadRequestCompareRoom", fields: [compareRoomId], references: [id], onDelete: Restrict)
  compareCard       CompareCard?        @relation("LeadRequestCompareCard", fields: [compareCardId], references: [id], onDelete: SetNull)
  offer             Offer?              @relation("LeadRequestOffer", fields: [offerId], references: [id], onDelete: SetNull)
  vendor            Vendor              @relation("LeadRequestVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  offerPriceVersion OfferPriceVersion?  @relation("LeadRequestOfferPriceVersion", fields: [offerPriceVersionId], references: [id], onDelete: SetNull)
  submittedBy       User                @relation("LeadRequestSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  histories         LeadStatusHistory[] @relation("LeadStatusHistoryLeadRequest")

  @@index([coupleId], name: "idx_lead_requests_couple_id")
  @@index([compareRoomId], name: "idx_lead_requests_compare_room_id")
  @@index([vendorId], name: "idx_lead_requests_vendor_id")
  @@index([status], name: "idx_lead_requests_status")
  @@index([submittedAt], name: "idx_lead_requests_submitted_at")
  @@index([contactPhoneHash], name: "idx_lead_requests_contact_phone_hash")
  @@map("lead_requests")
  @@schema("public")
}

