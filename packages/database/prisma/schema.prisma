  compareCard  CompareCard? @relation("ApprovalCompareCard", fields: [compareCardId], references: [id], onDelete: SetNull)
  coupleMember CoupleMember @relation("ApprovalCoupleMember", fields: [coupleMemberId], references: [id], onDelete: Restrict)
  user         User         @relation("ApprovalUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([compareRoomId], name: "idx_approvals_compare_room_id")
